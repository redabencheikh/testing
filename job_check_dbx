# ---- Helper: resolve workspace job names -> job IDs ----
def get_workspace_job_ids() -> dict:
    """Get all job IDs in the Databricks workspace.
    Returns:
        dict: A dictionary with job names as keys and job IDs as values.
    """
    _w = WorkspaceClient()
    output = {}
    for job in _w.jobs.list():
        if job.settings and job.settings.name:
            output[job.settings.name] = job.job_id
    if len(output) == 0:
        raise Exception(
            "No job found in the workspace. Please check your config file."
        )
    return output

# ---- Resolve monitored job IDs from the config job names ----
