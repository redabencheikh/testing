def _resolve_job_name(job_id):
    """Resolve a job_id to its human-readable name."""
    for k, v in all_workspace_jobs.items():
        if v == int(job_id):
            return k
    raise ValueError(f"Job ID {job_id} not found")


def _status_emoji(lifecycle, result, is_stale=False):
    """Return an emoji reflecting the job outcome."""
    if lifecycle == "RUNNING":
        return "▶️"
    if is_stale:
        return "⏰"
    if result == "SUCCESS":
        return "✅"
    if result in ("FAILED", "TIMEDOUT"):
        return "❌"
    return "⚠️"


def _status_color(lifecycle, result, is_stale=False):
    """Return an Adaptive Card color keyword based on job status."""
    if result in ("FAILED", "TIMEDOUT") or lifecycle == "INTERNAL_ERROR":
        return "Attention"
    if is_stale:
        return "Warning"
    if lifecycle == "RUNNING":
        return "Accent"
    if result == "SUCCESS":
        return "Good"
    return "Warning"


def _job_row_block(row):
    """One ColumnSet row for a job — fixed-width columns, colored name, clickable link."""
    emoji = _status_emoji(row["lifecycle"], row["result"], row["is_stale"])
    color = _status_color(row["lifecycle"], row["result"], row["is_stale"])
    name  = row["job_name"]  # no truncation — wrap handles it

    name_block = {
        "type": "TextBlock",
        "text": name,
        "size": "Small",
        "wrap": True,
        "color": color,
    }
    # Keep row-level quick access to the run page when available.
    # Note: TextBlock does not support selectAction in Adaptive Cards -> use a markdown link instead.
    if "run_url" in row and row["run_url"]:
        name_block["text"] = f"[{name}]({row['run_url']})"

    # Add an explicit link only for failed/error states to speed up troubleshooting from Teams.
    failed_states = {"FAILED", "TIMEDOUT", "INTERNAL_ERROR", "ERROR"}
    is_failed = (row["result"] in failed_states) or (row["lifecycle"] in failed_states)
    run_link_block = {
        "type": "TextBlock",
        "text": "-",
        "size": "Small",
        "isSubtle": True,
    }
    if is_failed and row["run_url"]:
        run_link_block = {
            "type": "TextBlock",
            "text": f"[Open Run]({row['run_url']})",
            "size": "Small",
            "color": "Attention",
            "weight": "Bolder",
        }

    return {
        "type": "ColumnSet",
        "columns": [
            {
                "type": "Column", "width": "auto",
                "items": [{"type": "TextBlock", "text": emoji, "size": "Small"}],
                "verticalContentAlignment": "Center",
            },
            {
                "type": "Column", "width": "stretch",
                "items": [name_block],
                "verticalContentAlignment": "Center",
            },
            {
                "type": "Column", "width": "110px",
                "items": [{"type": "TextBlock", "text": row["last_run"], "size": "Small", "isSubtle": True}],
                "verticalContentAlignment": "Center",
            },
            {
                "type": "Column", "width": "75px",
                "items": [run_link_block],
                "verticalContentAlignment": "Center",
                # Column supports selectAction: makes the whole cell clickable for failed jobs
                **({"selectAction": {"type": "Action.OpenUrl", "url": row["run_url"]}} if is_failed and row[
                    "run_url"] else {}),
            },
        ],
    }


