monitored_job_ids = [
    str(all_workspace_jobs[name])
    for name in MONITORED_JOBS
    if name in all_workspace_jobs
]

missing = [name for name in MONITORED_JOBS if name not in all_workspace_jobs]
if missing:
    raise Exception(
        f"{len(missing)} job name(s) from config not found in workspace: {missing}. "
        "Please update functional_checks_config.json or check your workspace job names."
    )

print(f"Resolved {len(monitored_job_ids)} job ID(s) for the DPF logs query.")

# ---- Build and run the DPF logs query ----
job_ids_str = ", ".join(monitored_job_ids)

dpf_logs_query = f"""
with dpf_logs as (
SELECT *, coalesce(context:attributes:domain, context:attributes:source) AS domain FROM (
    SELECT * FROM dpf.dpf_logs
    WHERE job_id IN ({job_ids_str})
    QUALIFY rank() OVER (PARTITION BY job_id ORDER BY id DESC) = 1
    ORDER BY logdate DESC
)
where level = 'error'
)
select job_id, count(*) as error_count
from dpf_logs
group by all
"""

df_log_errors = spark.sql(dpf_logs_query)
df_log_errors.cache()
log_error_count = df_log_errors.count()
print(f"Found {log_error_count} log(s) for monitored jobs in DPF logs.")
if log_error_count > 0:
