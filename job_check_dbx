# Build filter conditions
recon_filters = []
if RECON_DOMAINS:
    domains_str = ",".join([f"'{d}'" for d in RECON_DOMAINS])
    recon_filters.append(f"domain_name IN ({domains_str})")

if recon_filters:
    where_clause = " OR ".join(recon_filters)

    recon_query = f"""
    WITH last_reconciliation AS (
        SELECT *
        FROM dpf.v_dpf_reconciliation_results
        QUALIFY ROW_NUMBER() OVER (PARTITION BY target_layer, table_name ORDER BY start_time DESC) = 1
    ),unsuccessful AS (
    SELECT DOMAIN_NAME, STEP, SOURCE_LAYER, TARGET_LAYER, JOB_NAME,
           START_TIME, TABLE_NAME, COUNT_TARGET, COUNT_SOURCE, DIFFERENCE, SUCCESSFUL
    FROM last_reconciliation
    WHERE SUCCESSFUL = false
      AND ({where_clause})
    )
    SELECT distinct DOMAIN_NAME, TARGET_LAYER, SUCCESSFUL
    FROM unsuccessful
    """

    df_recon_failures = spark.sql(recon_query)
    df_recon_failures.cache()
    recon_fail_count = df_recon_failures.count()
    print(f"Found {recon_fail_count} reconciliation failure(s) on last run.")
    if recon_fail_count > 0:
        display(df_recon_failures)
    else:
        print("  \u2705 No reconciliation failures detected.")
