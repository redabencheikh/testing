# ---- Fetch latest run for each monitored job (parallelized) ----
def _fetch_job_status(job):
    """Fetch latest run status for a single job."""
    job_id = job.job_id
    job_name = job.settings.name

    runs = list(w.jobs.list_runs(job_id=job_id, limit=1))
    try:
        runs = list(w.jobs.list_runs(job_id=job.job_id, limit=1))
    except Exception as e:
        return {
            "job_id": job.job_id,
            "job_name": job.settings.name,
            "lifecycle": "ERROR",
            "result": str(e),
            "last_run": "N/A",
            "duration": "N/A",
            "run_url": "",
            "age": "never",
            "max_age_hours": _max_age_hours(job.settings.name),
            "is_stale": False,
        }

    max_age = _max_age_hours(job_name)

    if runs:
        r = runs[0]
        state = r.state
        life_cycle = state.life_cycle_state.value if state and state.life_cycle_state else "UNKNOWN"
        result = state.result_state.value if state and state.result_state else "-"
        start_time = _ts_to_str(r.start_time)
        duration = _duration_str(r.start_time, r.end_time)
        run_page = r.run_page_url or ""
        age_h = _age_hours(r.start_time)
        # a currently running job is never considered stale
        is_stale = life_cycle != "RUNNING" and age_h is not None and age_h > max_age
    else:
        life_cycle = "NEVER_RUN"
        result = "-"
        start_time = "N/A"
        duration = "N/A"
        run_page = ""
        age_h = None
        is_stale = False

    return {
        "job_id": job_id,
        "job_name": job_name,
        "lifecycle": life_cycle,
        "result": result,
        "last_run": start_time,
        "duration": duration,
        "run_url": run_page,
        "age": _age_str(age_h),
        "max_age_hours": max_age,
        "is_stale": is_stale,
    }


# Parallel execution — 15 jobsdpf_tst$0 at once
