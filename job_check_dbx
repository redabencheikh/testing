def highlight(value, is_bad):
    if is_bad:
        return f"🚨 {value}"
    return f"✅ {value}"


def build_adaptive_card(df, total, success, failed, running, df_log_errors=None, df_recon_failures=None):
    """Build a compact Adaptive Card — job status + functional checks."""
    now_str = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")

    # Exclude NEVER_RUN jobs from counts and display
    active_df = df.filter(F.col("lifecycle") != "NEVER_RUN")
    active_total = active_df.count()
    never_run_count = total - active_total

    # never run jobs
    never_run_df = df.filter(F.col("lifecycle") == "NEVER_RUN")

    # Count functional issues
    log_error_count = df_log_errors.count() if df_log_errors is not None and len(df_log_errors.columns) > 0 else 0
    recon_fail_count = df_recon_failures.count() if df_recon_failures is not None and len(
        df_recon_failures.columns) > 0 else 0

    # Overall status color for the header
    overall_color = "Attention" if (failed > 0 or log_error_count > 0 or recon_fail_count > 0) else "Good"

    def fmt(n):
        return f"{int(n):,}"

    header_facts = [
        {"title": "Environment", "value": dbx_server},
        {"title": "Report Time", "value": now_str},

        {"title": "Total Jobs", "value": fmt(total)},
        {"title": "▶️ Running", "value": fmt(running)},

        {"title": "✅ Success", "value": fmt(success)},
        {"title": "❌ Failed", "value": highlight(failed, failed > 0)},
        {"title": "⚠️ Never Run", "value": highlight(never_run_count, never_run_count > 0)},

        {"title": "🐞 Func Errors", "value": highlight(log_error_count, log_error_count > 0)},
        {"title": "⚖️ Recon Failures", "value": highlight(recon_fail_count, recon_fail_count > 0)},
    ]

    # ---- Jobs table header (matches new _job_row_block columns) ----
    table_header = {
        "type": "ColumnSet",
        "style": "emphasis",
        "columns": [
            {"type": "Column", "width": "auto",
             "items": [{"type": "TextBlock", "text": "", "size": "Small", "weight": "Bolder"}]},
            {"type": "Column", "width": "stretch",
             "items": [{"type": "TextBlock", "text": "Job Name", "size": "Small", "weight": "Bolder"}]},
            {"type": "Column", "width": "110px",
