# ---- Helper functions ----
def _ts_to_str(epoch_ms):
    """Convert epoch milliseconds to a readable UTC string."""
    if not epoch_ms:
        return "N/A"
    return datetime.fromtimestamp(epoch_ms / 1000, tz=timezone.utc).strftime("%m-%d %H:%M")


def _duration_str(start_ms, end_ms):
    """Human-readable duration between two epoch-ms timestamps."""
    if not start_ms or not end_ms:
        return "N/A"
    secs = int((end_ms - start_ms) / 1000)
    mins, secs = divmod(secs, 60)
    hrs, mins = divmod(mins, 60)
    if hrs:
        return f"{hrs}h {mins}m {secs}s"
    if mins:
        return f"{mins}m {secs}s"
    return f"{secs}s"


def _age_hours(epoch_ms):
    """Hours elapsed since an epoch-ms timestamp (None when unknown)."""
    if not epoch_ms:
        return None
    return (datetime.now(timezone.utc).timestamp() * 1000 - epoch_ms) / 3_600_000


def _age_str(hours):
    """Human-readable age from a number of hours."""
    if hours is None:
        return "never"
    if hours < 24:
        return f"{hours:.1f}h"
    days, rem = divmod(hours, 24)
    return f"{int(days)}d {rem:.0f}h"


def _job_staleness_conf(job_name):
    """Resolve (max_age_hours, skip_days) for a job, accepting a plain number or an object override."""
    override = STALENESS_OVERRIDES.get(job_name)
    if override is None:
        return STALENESS_DEFAULT_HOURS, STALENESS_DEFAULT_SKIP_DAYS
    if isinstance(override, dict):
        hours = float(override.get("max_age_hours", STALENESS_DEFAULT_HOURS))
        skip = _norm_days(override["skip_days"]) if "skip_days" in override else STALENESS_DEFAULT_SKIP_DAYS
        return hours, skip
    return float(override), STALENESS_DEFAULT_SKIP_DAYS


def _max_age_hours(job_name, now=None):
    """Staleness threshold for a job, extended by 24h for every non-running day in the lookback window."""
    base, skip_days = _job_staleness_conf(job_name)
    if not skip_days:
        return base

    now = now or datetime.now(timezone.utc)
    total = base
    for _ in range(10):  # converges in a few passes; guard against pathological configs
        window_days = int(total // 24)
        skipped = sum(
            1 for d in range(window_days + 1)
            if WEEKDAY_CODES[(now - timedelta(days=d)).weekday()] in skip_days
        )
        new_total = base + 24 * skipped
        if new_total == total:
            break
        total = new_total
    return total


