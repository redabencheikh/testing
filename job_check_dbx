def _norm_days(days):
    """Normalise weekday names to 3-letter uppercase codes (MON..SUN)."""
    return {str(d).strip().upper()[:3] for d in (days or [])}


WEEKDAY_CODES = ["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"]


STALENESS_DEFAULT_SKIP_DAYS = _norm_days(STALENESS_CONF.get("default_skip_days", []))
